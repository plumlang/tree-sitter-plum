{
  "name": "@plumlang/tree-sitter-plum",
  "version": "1.0.1",
  "description": "Tree-sitter grammar for Plumlang",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plumlang/tree-sitter-plum.git"
  },
  "homepage": "https://plum.elixpo.com",
  "bugs": {
    "url": "https://github.com/plumlang/tree-sitter-plum/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Elixpo and the Plumlang contributors",
    "email": "hello@elixpo.com",
    "url": "https://plum.elixpo.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "plum",
    "plumlang",
    "parser",
    "syntax-highlighting",
    "grammar"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm",
    "NOTICE"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.27.2"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
